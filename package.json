{
  "name": "@local/dsh-composer-command-alias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typing the Chinese enumeration comma at the start of a message (or after a space) opens the same slash-command menu as typing /.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "docs",
    "lib",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "node scripts/check.mjs test",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
